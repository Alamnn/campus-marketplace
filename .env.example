# ==============================================================================
# Campus Marketplace — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in any required settings.
# NOTE: In local development, if email credentials are left blank,
# 6-digit OTP verification codes will be printed directly to the terminal console!

# ------------------------------------------------------------------------------
# 1. EMAIL DISPATCH CONFIGURATION (Optional - Choose Option A or Option B)
# ------------------------------------------------------------------------------

# OPTION A: Standard SMTP Relay (e.g. Gmail App Password, Brevo, or University Mail Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Campus Marketplace <noreply@university.edu>"

# OPTION B: Resend API (Transactional Email Gateway)
RESEND_API_KEY=
RESEND_FROM="Campus Marketplace <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 2. SECURITY & SESSION CONFIGURATION
# ------------------------------------------------------------------------------
# Secret salt for cryptographic HMAC SHA-256 OTP signature hashing:
OTP_SECRET=campus-marketplace-otp-secret-2026

# Allowed campus domains for registration (comma-separated, leave blank to allow all valid emails)
# Example: .edu,.edu.my,.ac.uk
ALLOWED_DOMAINS=

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (Optional - Runs Local-First if Unconfigured)
# ------------------------------------------------------------------------------
# If you wish to connect your own Firebase Cloud Firestore database instance:
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
